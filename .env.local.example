# Powers the "X% of people guessed the level" stat on the result card
# (src/lib/completions.ts). Optional — the app runs fine without it, that
# stat just won't be shown.
#
# Get these by adding the "Upstash for Redis" integration to your Vercel
# project (Vercel dashboard -> Storage -> Marketplace Database Providers ->
# Upstash), or from an existing Upstash Redis database's REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
